#
# example-external.env - Settings for your own MariaDB server. Copy to .env.
#

# IMPORTANT: Values left blank are required. Remove leading # to uncomment
# lines when necessary.  Docker compose will not start until they are filled
# in. External databases are not created as part of bringing up the container.
# The database and user must already exist in your external database server.

# SMTP username and password for email alerts (optional - only if email
# alerts are enabled in your config)
#SMTP_USER=
#SMTP_PASSWORD=

# Connection pool sizing (optional). Defaults are 1 and 5. Raise the max
# if you run many monitors. Both must be at least 1, and min must not
# exceed max.
#DB_POOL_MIN_SIZE=1
#DB_POOL_MAX_SIZE=5

# DB_HOST can be either a hostname that resolves via DNS or a valid IP address.
DB_HOST=

# DB_PORT only needs set if using a non-standard port.
#DB_PORT=3306

# DB_NAME is the name of the database on your server.
DB_NAME=

# DB_USER is the user the software uses to connect to the database.
DB_USER=

# If a password contains a dollar sign ($), put the whole value in single quotes,
# such as DB_PASSWORD='pa$word', or write each $ twice, such as DB_PASSWORD=pa$$word.
# Without using one of these methods, Docker Compose reads anything that follows the
# dollar sign as the name of a variable, and the password is silently cut short.

# DB_PASSWORD must be specified for the software to authenticate.
DB_PASSWORD=
