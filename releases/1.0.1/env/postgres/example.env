#
# example.env - Settings for the bundled PostgreSQL stack. Copy to .env.
#

# IMPORTANT: Values left blank are required. Remove leading # to uncomment
# lines when necessary.  Docker compose will not start until they are filled
# in. Also, DO NOT set DB_HOST, DB_PORT or DB_BACKEND here. The compose file
# automatically configures them for the bundled database, and a value set in
# .env would override it.

# SMTP username and password for email alerts (optional - use only if email
# alerts are enabled in your alerts.yaml config).
#SMTP_USER=
#SMTP_PASSWORD=

# Connection pool sizing (optional). Defaults are 1 and 5. Raise the max
# if you run many monitors. Both must be at least 1, and min must not
# exceed max.
#DB_POOL_MIN_SIZE=1
#DB_POOL_MAX_SIZE=5

# The following settings are applied when the database is first created.
# Changing them here later does not update them in an existing database.

# If a password contains a dollar sign ($), put the whole value in single quotes,
# such as DB_PASSWORD='pa$word', or write each $ twice, such as DB_PASSWORD=pa$$word.
# Without using one of these methods, Docker Compose reads anything that follows the
# dollar sign as the name of a variable, and the password is silently cut short.

# Password for the superuser account. The software never connects using
# it. This is meant for administrative use only.
POSTGRES_ROOT_PASSWORD=

# DB_NAME is the name of the database.
DB_NAME=

# DB_USER is the user the software uses to connect to the database.
DB_USER=

# DB_PASSWORD must be specified for the software to authenticate.
DB_PASSWORD=
